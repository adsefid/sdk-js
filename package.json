{
  "name": "@adsefid/sdk",
  "version": "0.8.0",
  "description": "Official JavaScript/TypeScript client SDK for the adsefid.com SMS Web Service REST API",
  "license": "MIT",
  "keywords": [
    "adsefid",
    "sms",
    "messenger",
    "webhooks",
    "sdk",
    "typescript",
    "node",
    "bun",
    "deno",
    "edge",
    "workers"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adsefid/sdk-js.git"
  },
  "homepage": "https://github.com/adsefid/sdk-js#readme",
  "bugs": {
    "url": "https://github.com/adsefid/sdk-js/issues"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:bun": "bun --bun vitest run",
    "test:deno": "deno run --allow-all --no-lock node_modules/vitest/vitest.mjs run",
    "smoke": "node tests/runtime/smoke.mjs",
    "smoke:bun": "bun tests/runtime/smoke.mjs",
    "smoke:deno": "deno run --no-lock --allow-read --allow-net tests/runtime/smoke.mjs",
    "check:package": "publint --strict && attw --pack . --profile node16"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "publint": "0.3.25",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
